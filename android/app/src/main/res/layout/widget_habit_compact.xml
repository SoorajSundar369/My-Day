<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_habit" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_habit" android:contentDescription="New habit">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_plus" android:tint="#FFCB94" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_open" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_neutral" android:contentDescription="Open app">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_lock" android:tint="#E3E5F7" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
