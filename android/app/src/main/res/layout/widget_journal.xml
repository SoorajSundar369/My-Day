<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/wi_notebook" android:tint="#B7BBE0" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:text="JOURNAL" android:textColor="#B7BBE0" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
    </LinearLayout>
    <TextView android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:textColor="#EEF0FF" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" android:paddingBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal">
    <LinearLayout android:id="@+id/btn_journal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:layout_marginEnd="6dp"
        android:background="@drawable/wbtn_primary" android:contentDescription="Write">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/wtile_primary">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wi_pencil" android:tint="#D9D4FF" android:contentDescription="@null"/>
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp"
            android:text="Write" android:textColor="#D9D4FF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/btn_voice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp"
        android:background="@drawable/wbtn_neutral" android:contentDescription="Voice">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/wtile_neutral">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/wi_microphone" android:tint="#E3E5F7" android:contentDescription="@null"/>
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp"
            android:text="Voice" android:textColor="#E3E5F7" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
