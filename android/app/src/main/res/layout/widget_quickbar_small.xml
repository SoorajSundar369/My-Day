<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_expense" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_expense" android:contentDescription="Add expense">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_arrow_up_right" android:tint="#FFA8B6" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_income" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_income" android:contentDescription="Add income">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_arrow_down_left" android:tint="#7DE8C4" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_journal" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_primary" android:contentDescription="Write in journal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_pencil" android:tint="#D9D4FF" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center">
        <FrameLayout android:id="@+id/btn_task" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
            android:background="@drawable/wcirc_neutral" android:contentDescription="Add task">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/wi_circle_check" android:tint="#E3E5F7" android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
